# Copie para .env e preencha antes de rodar docker compose ou scripts/create-secrets.*
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.

# Chave JWT compartilhada entre UsersAPI, CatalogAPI e Kong (openssl rand -base64 32)
JWT_SECRET=

# Senha do PostgreSQL (usuário: fcg)
POSTGRES_PASSWORD=

# Senha do RabbitMQ (usuário: guest)
RABBITMQ_PASSWORD=

# Senha do admin do Grafana
GRAFANA_ADMIN_PASSWORD=

# Credenciais do IAM user "fcg-services" (publicação SQS para a Lambda de notificações)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SQS_USER_CREATED_QUEUE_URL=
AWS_SQS_PAYMENT_PROCESSED_QUEUE_URL=
