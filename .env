# Copie este arquivo para .env e preencha os valores antes de rodar docker compose up

# Chave JWT compartilhada entre UsersAPI e CatalogAPI
# Gere com: openssl rand -base64 32
JWT_SECRET=UvPTu5UZIcSe0V1onJSNTWT579OHlmoxXA1flLgKpow=

# Senha do PostgreSQL (usuario: fcg)
POSTGRES_PASSWORD=fcg_secret

# Senha do RabbitMQ (usuario: guest)
RABBITMQ_PASSWORD=guest

# Credenciais do IAM user "fcg-services" (dual-publish para a Lambda de notificações).
# NÃO preencha com valores reais aqui — diferente do JWT/Postgres acima, uma chave AWS
# é válida contra a API real da AWS. Preencha localmente após clonar e nunca commite
# o resultado (o GitHub Push Protection bloqueia isso automaticamente, e com razão).
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_OWN
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_OWN
AWS_REGION=us-east-1

AWS_SQS_USER_CREATED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/122102659912/fcg-user-created
AWS_SQS_PAYMENT_PROCESSED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/122102659912/fcg-payment-processed
